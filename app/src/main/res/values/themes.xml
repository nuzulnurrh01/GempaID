<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme yang digunakan oleh Android sebelum Compose mengambil alih rendering.
        Theme.Material3.DayNight.NoActionBar: memastikan tidak ada ActionBar bawaan
        karena kita menggunakan TopAppBar dari Jetpack Compose.
        windowSplashScreenBackground: warna background saat splash screen (Android 12+).
    -->
    <style name="Theme.GempaID" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FF6D00</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
